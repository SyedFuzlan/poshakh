PORT=9000

# ── Owner Dashboard Login ───────────────────────────────────────────────────
# Generate your hash: node -e "require('bcryptjs').hash('YourPassword', 12).then(h => console.log('OWNER_PASSWORD_HASH=' + h))"
OWNER_EMAIL=your@email.com
OWNER_PASSWORD_HASH=$2b$12$exampleHashHere...replaceWithRealHash
# OWNER_PASSWORD= (removed — use OWNER_PASSWORD_HASH above)

# ── JWT Secret ─────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_command_above

# ── Frontend URL (for CORS) ─────────────────────────────────────────────────
# In production, set this to your actual frontend domain: https://poshakh.in
STORE_CORS=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Format: postgres://user:password@host:port/database
# Example (local): postgres://postgres:postgres@localhost:5432/poshakh
DATABASE_URL=

# ── Razorpay ────────────────────────────────────────────────────────────────
# Test keys: https://dashboard.razorpay.com → Settings → API Keys (Test Mode)
# Switch to live keys before going live
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Set this in Razorpay dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ── SMS (Fast2SMS) ──────────────────────────────────────────────────────────
# Key from https://www.fast2sms.com
FAST2SMS_API_KEY=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Get key from: https://resend.com/api-keys
# Domain noreply@poshakh.in must be verified in Resend dashboard before production use
RESEND_API_KEY=

# ── App URL (for email links) ───────────────────────────────────────────────
# Frontend origin — used for the password-reset link (frontend page).
# In production: https://poshakh.in
# In dev: http://localhost:3000 (Next.js dev server)
APP_URL=http://localhost:3000

# ── Backend URL (for backend API links in emails) ───────────────────────────
# The origin of this backend server — used for the email-verification link
# which hits /api/customers/verify-email directly on the backend.
# In production: https://api.poshakh.in (or wherever the backend is hosted)
# In dev: http://localhost:9000
BACKEND_URL=http://localhost:9000
